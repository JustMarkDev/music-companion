{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Companion",
  "version": "1.2.2",
  "identifier": "com.musiccompanion.overlay",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Music Companion",
        "width": 520,
        "height": 720,
        "minWidth": 220,
        "minHeight": 110,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true
      },
      {
        "label": "settings",
        "title": "Music Companion — Impostazioni",
        "url": "index.html?view=settings",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Music Companion",
    "category": "Music",
    "shortDescription": "Live lyrics overlay for Windows and macOS",
    "longDescription": "A transparent always-on-top lyrics overlay that follows the active system media session and fetches lyrics from LRCLIB."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0Qjc2MUUwMzA1OUY1QTgKUldTbzlWa3c0R0czSkJVNVZBeU5kYXhqbUwwWWNhdEtJNERWajgrbDBzeFFrSytwYVAzSHQwbDAK",
      "endpoints": [
        "https://github.com/JustMarkDev/music-companion/releases/latest/download/latest.json"
      ]
    }
  }
}
