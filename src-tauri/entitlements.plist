<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Applied when a Developer ID signature is configured, which turns on the
	     hardened runtime. -->

	<!-- The AppleScript fallback drives Music and Spotify through Apple events. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!-- The now-playing reader runs the bundled MediaRemote adapter under
	     /usr/bin/perl, which loads the adapter framework at run time. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
